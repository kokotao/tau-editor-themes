{
  "schemaVersion": 2,
  "type": "theme",
  "id": "tau-solarized",
  "name": "Tau Solarized",
  "version": "1.0.0",
  "author": "Tau Editor",
  "license": "MIT",
  "defaultMode": "light",
  "modes": {
    "light": {
      "colors": {
        "textPrimary": "#334155",
        "textSecondary": "#64748b",
        "accentBrand": "#0f766e",
        "accentBrandStrong": "#115e59",
        "stateSuccess": "#15803d",
        "stateDanger": "#b91c1c",
        "bgApp": "#f8fafc",
        "panelBase": "#ffffff"
      },
      "monaco": { "base": "vs", "rules": [], "colors": { "editor.background": "#f8fafc", "editor.foreground": "#334155" } }
    },
    "dark": {
      "colors": {
        "textPrimary": "#e2e8f0",
        "textSecondary": "#94a3b8",
        "accentBrand": "#5eead4",
        "accentBrandStrong": "#99f6e4",
        "stateSuccess": "#86efac",
        "stateDanger": "#fca5a5",
        "bgApp": "#0f172a",
        "panelBase": "#111827"
      },
      "monaco": { "base": "vs-dark", "rules": [], "colors": { "editor.background": "#0f172a", "editor.foreground": "#e2e8f0" } }
    }
  }
}
