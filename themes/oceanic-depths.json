        "bgApp": "#071a24",
        "panelBase": "#0d2a38",
        "textPrimary": "#e1f7fb",
        "textSecondary": "#97c9d4",
        "accentBrand": "#22d3ee",
        "accentBrandStrong": "#67e8f9",
        "stateSuccess": "#86efac",
        "stateDanger": "#fca5a5"
      },
      "monaco": { "base": "vs-dark", "rules": [], "colors": { "editor.background": "#071a24", "editor.foreground": "#e1f7fb" } }
    }
