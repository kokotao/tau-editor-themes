{
  "schemaVersion": 2,
  "type": "theme",
  "id": "oceanic-depths",
  "name": "Oceanic Depths",
  "version": "1.0.0",
  "author": "Tau Editor Community",
  "license": "MIT",
  "defaultMode": "dark",
  "modes": {
    "light": {
      "colors": {
        "bgApp": "#effaff",
        "panelBase": "#ffffff",
        "textPrimary": "#0c3040",
        "textSecondary": "#4b6a77",
        "accentBrand": "#0891b2",
        "accentBrandStrong": "#0e7490",
        "stateSuccess": "#15803d",
