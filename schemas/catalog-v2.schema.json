{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kokotao/tau-editor-themes/schemas/catalog-v2.schema.json",
  "title": "Tau Editor Theme Catalog v2",
  "type": "object",
  "required": ["schemaVersion", "items"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/item" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "item": {
      "type": "object",
      "required": ["id", "type", "name", "version", "author", "license", "file"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "maxLength": 64 },
        "type": { "enum": ["theme", "palette"] },
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "version": { "type": "string", "minLength": 1, "maxLength": 32 },
        "author": { "type": "string", "minLength": 1, "maxLength": 128 },
        "license": { "type": "string", "minLength": 1, "maxLength": 64 },
        "file": { "type": "string", "pattern": "^(themes|palettes)/[^/]+\\.json$", "maxLength": 256 },
        "preview": { "type": "string", "maxLength": 512 },
        "tags": { "type": "array", "maxItems": 20, "items": { "type": "string", "maxLength": 32 } }
      },
      "additionalProperties": false
    }
  }
}
